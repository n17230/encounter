/*
 * Shared design tokens + base component classes for every UI Toolkit panel
 * in the project. Apply "theme-root" to a document's top-level element to
 * bring these custom properties into scope (Unity's USS has no universal
 * :root selector). Follows BEM: blocks are standalone components, elements
 * use __, modifiers use -- (see .claude/skills/game-ui-design).
 */

.theme-root {
    --color-scrim: rgba(10, 11, 15, 0.55);
    --color-panel: #22262F;
    --color-panel-border: #3A3F4B;
    --color-surface: #2A2E38;
    --color-surface-alt: #262A34;
    --color-surface-hover: #333846;
    --color-surface-pressed: #20232B;
    --color-accent: #D9A54B;
    --color-accent-hover: #F0C274;
    --color-text: #ECE8DE;
    --color-text-secondary: #9AA0AC;
    --color-danger: #C1554B;
    --color-disabled: #4A4E58;
}

.menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-scrim);
}

.panel {
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 10px;
    padding: 20px;
}

.panel__header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.panel__title {
    flex-grow: 1;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.panel__header-spacer {
    width: 60px;
}

.panel__footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 14px;
}

.section-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-secondary);
    letter-spacing: 2px;
    margin-top: 12px;
    margin-bottom: 6px;
}

.button {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 14px;
    padding: 6px 14px;
    -unity-text-align: middle-center;
}

.button:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
}

.button:active {
    background-color: var(--color-surface-pressed);
}

.button--ghost {
    background-color: rgba(0, 0, 0, 0);
}

.icon-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--color-text-secondary);
    font-size: 14px;
    padding: 4px 8px;
}

.icon-button:hover {
    color: var(--color-accent);
}

.field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

/* Tab bar for switching between a fixed set of categories - shared by
   Skills (ability categories) and Equipment (inventory slot categories). */
.category-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 6px;
}

.category-tab {
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 11px;
}

.category-tab--selected {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
}

.field-row__label {
    width: 220px;
    color: var(--color-text);
    font-size: 15px;
}

/* Single-line text entry (the Lobby panel's character name). UI Toolkit's
   TextField nests its editable box in a unity-base-text-field__input child,
   so the surface styling goes on that descendant, not the field itself. */
.text-field {
    flex-grow: 1;
    margin: 0;
}

.text-field .unity-base-text-field__input {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    color: var(--color-text);
    font-size: 15px;
    padding: 6px 10px;
}

.text-field:focus .unity-base-text-field__input {
    border-color: var(--color-accent);
}

/* One connected player per row - shared by the Lobby and Choice panels'
   player lists (name on the left, Ready/Waiting on the right). */
.player-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 8px;
    border-radius: 4px;
    margin-bottom: 2px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
}

.player-row--local {
    border-color: var(--color-accent);
}

.player-row__name {
    color: var(--color-text);
    font-size: 14px;
}

.player-row__status {
    color: var(--color-text-secondary);
    font-size: 12px;
}

.player-row__status--ready {
    color: var(--color-accent);
}

/* "Every player's picks" sections (PicksSection.cs) - shared by Skills
   (ability icons) and Equipment (item icons): a name, then that player's
   icons left to right, wrapping. */
.picks-row {
    margin-bottom: 10px;
}

.picks-row__name {
    color: var(--color-text);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.picks-row--local .picks-row__name {
    color: var(--color-accent);
}

.picks-row__icons {
    flex-direction: row;
    flex-wrap: wrap;
}

.picks-icon {
    flex-shrink: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
}

/* Sizes are border-box, so box = image + 2 x padding + 2 x 1px border.
   Both variants render the image at the size the panels already use:
   72 - 6 - 2 = 64, same as .kit-slot__icon / .ability-card__icon;
   72 - 8 - 2 = 62, same as an inventory .equipment-slot (72px box, 1px
   border, 4px button padding). */
.picks-icon--ability {
    width: 72px;
    height: 72px;
    padding: 3px;
}

.picks-icon--item {
    width: 72px;
    height: 72px;
    padding: 4px;
}

.picks-icon--clickable:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
}

.picks-icon__image {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-alt);
    border-radius: 4px;
}

.picks-icon__label {
    position: absolute;
    left: 3px;
    top: 2px;
    color: var(--color-text-secondary);
    font-size: 9px;
}

.slider {
    flex-grow: 1;
}

/* Descendant (not child) selectors: BaseSlider nests tracker/dragger inside
   an intermediate unity-base-slider__drag-container, so they're grandchildren
   of .slider, not direct children. */
.slider .unity-base-slider__tracker {
    background-color: var(--color-surface);
    border-width: 0;
    border-radius: 3px;
    height: 4px;
}

.slider .unity-base-slider__dragger {
    background-color: var(--color-text);
    border-width: 2px;
    border-color: var(--color-accent);
    border-radius: 8px;
    width: 16px;
    height: 16px;
}

.slider:hover .unity-base-slider__dragger {
    background-color: var(--color-accent-hover);
}

/* Cursor-following hover tooltip (see HoverTooltip.cs) - shared by every
   panel with hoverable rows (Skills, Equipment). pickingMode is
   set to Ignore in code so the tooltip itself never intercepts pointer
   events. */
.hover-tooltip {
    position: absolute;
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    padding: 8px 10px;
    max-width: 320px;
}

.hover-tooltip__text {
    /* Explicit width, not just relying on the parent's max-width - an
       absolutely-positioned ancestor's max-width isn't a reliable wrap
       constraint for a child Label, and the un-wrapped text was rendering
       as one long unreadable line. 300 = 320 max-width minus the
       container's 10px+10px horizontal padding. */
    width: 300px;
    color: var(--color-text);
    font-size: 13px;
    white-space: normal;
}
