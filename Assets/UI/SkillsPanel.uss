/* Panel-specific layout for the Skills screen. Shared look lives in Theme.uss. */

#skills-panel {
    width: 720px;
    min-height: 540px;
}

/* "Your Kit" toolbar - mirrors the real in-game ability bar's row-of-slots
   shape (see PlayerAbilities' own bar), just without a cooldown sweep since
   there's nothing to be on cooldown in a menu. */
.kit-toolbar {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 10px;
}

.kit-slot {
    width: 76px;
    height: 60px;
    margin-right: 6px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    align-items: center;
    justify-content: center;
}

.kit-slot--empty {
    opacity: 0.5;
}

.kit-slot--selected {
    border-width: 2px;
    border-color: var(--color-accent);
}

.kit-slot__empty-label {
    color: var(--color-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.kit-slot__button {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px;
}

.kit-slot__name {
    color: var(--color-text);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.kit-slot__key {
    color: var(--color-text-secondary);
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-top: 3px;
}

.kit-subrow {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-alt);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 12px;
    display: none;
}

.kit-subrow__label {
    flex-grow: 1;
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
}

.kit-subrow > .button {
    margin-left: 6px;
}

.category-tabs {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 6px;
}

.category-tab {
    margin-right: 4px;
    padding: 4px 10px;
    font-size: 11px;
}

.category-tab--selected {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
}

#available-scroll {
    max-height: 280px;
    margin-top: 4px;
}

.ability-card {
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.ability-card:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
}

.ability-card__icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: var(--color-surface-alt);
    border-radius: 4px;
}

.ability-card__text-column {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.ability-card__name-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    align-self: stretch;
    margin-bottom: 3px;
}

.ability-card__name {
    color: var(--color-text);
    font-size: 15px;
    -unity-font-style: bold;
}

.ability-card__meta {
    color: var(--color-text-secondary);
    font-size: 12px;
}

.ability-card__description {
    /* Without this, the card (align-items: flex-start) never gives this
       Label a bounded width to wrap against - it sizes to its own
       unwrapped content instead of the card's width, which can make it
       wrap at the wrong point or sit misaligned with the name row above it. */
    align-self: stretch;
    color: var(--color-text-secondary);
    font-size: 12px;
    white-space: normal;
}
