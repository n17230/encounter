/* Panel-specific layout for the Skills screen. Shared look lives in Theme.uss. */

#skills-panel {
    /* No min-height - a forced 540px minimum left tons of empty panel
       space below any tab with only a couple of abilities in it. Let the
       panel size to whatever its actual content (header + kit toolbar +
       tabs + however many cards) needs. 720 was the single-column width;
       the picks column (240 + 24 gap) now sits to its left. */
    width: 984px;
}

/* Picks column on the left, the original single column on the right -
   see PicksSection.cs for what fills the picks column. */
.skills-columns {
    flex-direction: row;
}

.skills-column {
    flex-direction: column;
}

.skills-column--picks {
    width: 240px;
    margin-right: 24px;
}

.skills-column--main {
    width: 720px;
}

.skills-picks-scroll {
    max-height: 480px;
    margin-top: 4px;
}

/* Theme.uss's .panel__title is shared by every panel and defaults to
   centered - overridden here rather than in Theme.uss so this stays scoped
   to Skills instead of re-centering every other panel's title too. */
#skills-panel .panel__title {
    -unity-text-align: middle-left;
}

/* "Your Kit" toolbar - mirrors the real in-game ability bar's row-of-slots
   shape (see PlayerAbilities' own bar), just without a cooldown sweep since
   there's nothing to be on cooldown in a menu. */
.kit-toolbar {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 10px;
}

.kit-slot {
    width: 76px;
    height: 90px;
    margin-right: 6px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    align-items: flex-start;
    justify-content: center;
}

.kit-slot--empty {
    opacity: 0.5;
}

.kit-slot--selected {
    border-width: 2px;
    border-color: var(--color-accent);
}

.kit-slot--dragging {
    opacity: 0.5;
}

.kit-slot--drop-target {
    border-width: 2px;
    border-color: var(--color-accent-hover);
}

.kit-slot__empty-label {
    color: var(--color-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.kit-slot__button {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px;
}

.kit-slot__icon {
    /* Same fixed 64x64 as .ability-card__icon in the Available Abilities
       list, for consistent icon size between the two - the slot itself
       (90px tall) is sized to fit this plus the key label below it. */
    width: 64px;
    height: 64px;
    background-color: var(--color-surface-alt);
    border-radius: 4px;
}

.kit-slot__key {
    color: var(--color-text-secondary);
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-top: 3px;
}

.kit-subrow {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-surface-alt);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 12px;
    display: none;
}

.kit-subrow__label {
    flex-grow: 1;
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
}

.kit-subrow > .button {
    margin-left: 6px;
}

#available-scroll {
    max-height: 280px;
    margin-top: 4px;
}

.ability-card {
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.ability-card:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
}

.ability-card__icon {
    /* Fixed size, not stretched to the row's height - stretching left the
       actual icon art small and centered inside a tall, mostly-empty box. */
    width: 64px;
    height: 64px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: var(--color-surface-alt);
    border-radius: 4px;
}

.ability-card__text-column {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.ability-card__name-row {
    flex-direction: row;
    justify-content: space-between;
    /* UI Toolkit's USS has no "baseline" value (unlike web CSS) - flex-end
       is the closest approximation for aligning the differently-sized name
       and meta text. */
    align-items: flex-end;
    align-self: stretch;
    margin-bottom: 3px;
}

.ability-card__name {
    color: var(--color-text);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
}

.ability-card__meta {
    color: var(--color-text-secondary);
    font-size: 12px;
    -unity-text-align: upper-right;
}

.ability-card__description {
    /* Without this, the card (align-items: flex-start) never gives this
       Label a bounded width to wrap against - it sizes to its own
       unwrapped content instead of the card's width, which can make it
       wrap at the wrong point or sit misaligned with the name row above it. */
    align-self: stretch;
    color: var(--color-text-secondary);
    font-size: 12px;
    white-space: normal;
    /* ability-card is a Button, and Unity's default runtime theme sets
       Button text-align to middle-center - that's an INHERITED USS
       property, so every unstyled descendant Label picks it up too. It
       was invisible on Name/Meta (their own box is content-sized, so
       center vs. left looks identical) but this Label is stretched to
       the card's full width, so the inherited center-align was visibly
       centering the whole description paragraph. */
    -unity-text-align: upper-left;
}
