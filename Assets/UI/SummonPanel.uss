/* Panel-specific layout for the Summon Mobs screen. Shared look lives in Theme.uss. */

#summon-panel {
    width: 320px;
}

#mob-scroll {
    max-height: 220px;
    margin-top: 4px;
    margin-bottom: 10px;
}

.mob-row {
    -unity-text-align: middle-left;
    padding: 4px 8px;
    border-radius: 4px;
    margin-bottom: 2px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    color: var(--color-text);
}

.mob-row:hover {
    background-color: var(--color-surface-hover);
}

.mob-row:active {
    background-color: var(--color-surface-pressed);
}

.mob-row--selected {
    background-color: var(--color-surface-alt);
    color: var(--color-accent);
}

#count-row {
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

/* Overrides Theme.uss's shared .field-row__label (220px, sized for the
   wider Options panel) - in this narrower 320px panel that width was
   eating most of the row, shoving the -/count/+ controls off-center
   instead of letting #count-row's justify-content: center work. */
#count-row .field-row__label {
    width: auto;
    margin-right: 8px;
}

.count-stepper {
    width: 34px;
    padding: 4px;
}

.count-label {
    width: 40px;
    -unity-text-align: middle-center;
    color: var(--color-text);
    font-size: 15px;
}

#summon-button, #summon-skeletons-button {
    margin-bottom: 8px;
}
