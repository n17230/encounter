/* Panel-specific layout for the Equipment screen. Shared look lives in Theme.uss. */

#equipment-panel {
    width: 720px;
}

.equipment-columns {
    flex-direction: row;
    margin-top: 4px;
}

.equipment-column {
    flex-direction: column;
}

.equipment-column--inventory {
    flex-grow: 1;
    margin-left: 24px;
}

.equip-grid {
    flex-direction: row;
    flex-wrap: wrap;
    /* 3 columns * (72px box + 6px gap) - wraps to exactly 3 across, 4 rows
       for the 12 EquipmentSlot values, matching the old paper-doll's
       3-column layout. */
    width: 234px;
}

.inventory-scroll {
    max-height: 320px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.equipment-slot {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
}

.equipment-slot__button {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px;
}

.equipment-slot__button:hover {
    background-color: var(--color-surface-hover);
}

.equipment-slot__icon {
    /* Fills the whole box - unlike .ability-card__icon/.kit-slot__icon,
       there's no sibling text competing for space here, so a full-size
       icon is correct rather than something to avoid. */
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-alt);
    border-radius: 4px;
}

.equipment-slot__label {
    position: absolute;
    left: 3px;
    top: 2px;
    color: var(--color-text-secondary);
    font-size: 9px;
}

.equipment-slot__none-label {
    flex-grow: 1;
    color: var(--color-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.equipment-empty-label {
    display: none;
    color: var(--color-text-secondary);
    font-size: 13px;
    margin-top: 8px;
}
