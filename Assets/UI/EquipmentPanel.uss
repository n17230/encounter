/* Panel-specific layout for the Equipment screen. Shared look lives in Theme.uss. */

#equipment-panel {
    width: 944px;
}

.equipment-columns {
    flex-direction: row;
    margin-top: 4px;
}

.equipment-column {
    flex-direction: column;
}

.equipment-column--preview {
    margin-right: 24px;
}

.equipment-preview-image {
    width: 200px;
    height: 380px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
}

.equipment-preview-rotate-row {
    flex-direction: row;
    margin-top: 6px;
}

.equipment-preview-rotate-button {
    flex-grow: 1;
    padding: 4px 0;
}

.equipment-preview-rotate-button:first-child {
    margin-right: 6px;
}

.equipment-preview-rotate-button__label {
    font-size: 11px;
    -unity-text-align: middle-center;
}

.equipment-column--inventory {
    flex-grow: 1;
    margin-left: 24px;
}

/* Every player's equipped items, between the preview and the inventory -
   3 x (72px box + 6px gap) wide, so one row of icons wraps the way the old
   paper-doll grid was laid out. See PicksSection.cs. */
.equipment-column--picks {
    width: 234px;
}

.equipment-picks-scroll {
    max-height: 420px;
    margin-top: 4px;
}

.inventory-scroll {
    max-height: 320px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.equipment-slot {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
}

.equipment-slot__button {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px;
}

.equipment-slot__button:hover {
    background-color: var(--color-surface-hover);
}

.equipment-slot__icon {
    /* Fills the whole box - unlike .ability-card__icon/.kit-slot__icon,
       there's no sibling text competing for space here, so a full-size
       icon is correct rather than something to avoid. */
    width: 100%;
    height: 100%;
    background-color: var(--color-surface-alt);
    border-radius: 4px;
}

.equipment-slot__none-label {
    flex-grow: 1;
    color: var(--color-text-secondary);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.equipment-empty-label {
    display: none;
    color: var(--color-text-secondary);
    font-size: 13px;
    margin-top: 8px;
}
